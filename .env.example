# Self-hosting with docker compose. Copy to .env (gitignored) and fill in the values.

# Database (created automatically by the db service)
POSTGRES_USER=foyer
POSTGRES_DB=foyer
# Required. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Required. Signs session tokens. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional. Public OAuth client id from Google Cloud. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Optional. Enables GET /api/admin/stats (at least 32 characters). Leave empty to disable.
ADMIN_STATS_TOKEN=

# Optional. Name shown in the interface and contact address on the privacy page.
APP_NAME=
PRIVACY_CONTACT_EMAIL=

# Link to your source code. Required by the AGPL if you modify the app. Empty links upstream.
SOURCE_URL=

# Port the app is published on
WEB_PORT=8080
