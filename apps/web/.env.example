# Public address shown on the privacy page (GDPR Art. 13). Not a secret.
# Leave empty to use the default published address.
VITE_PRIVACY_CONTACT_EMAIL=foyer-manager@gmail.com

# Name shown in the interface, legal pages and the browser tab.
# Leave empty to use "Foyer Manager". The allotwe.com deployment sets Allotwe.
VITE_APP_NAME=

# Link to the source code shown in the footer. Required by the AGPL if you run a modified version.
# Leave empty to link to the upstream repository.
VITE_SOURCE_URL=
