# Placeholder only. Copy to .env.development and replace with real values.
# Do not put Neon passwords, JWT secrets, or OAuth client ids in this file.
DEPLOYMENT_MODE=cloud
DATABASE_URL="postgresql://user:password@localhost:5432/foyer_dev"
PORT=3000
JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=7d
# Public OAuth client id from Google Cloud. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
# Enables GET /api/admin/stats (Bearer token, at least 32 characters). Leave empty to disable.
# Generate one with: openssl rand -base64 48
ADMIN_STATS_TOKEN=
