{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @foyer/types && npm run build -w @foyer/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__route=:path*" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
