{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @foyer/types && npm run build -w @foyer/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "includeFiles": "node_modules/.prisma/client/**"
    }
  }
}
